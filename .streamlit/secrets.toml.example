# ==============================================================================
# STAR AIR BI PORTAL - STREAMLIT SECRETS CONFIGURATION
# ==============================================================================
#
# This file contains the template for configuring database connections.
# For local testing, copy this file to `.streamlit/secrets.toml` and fill in your credentials.
# For Cloud deployment, paste these keys directly into the "Secrets" field in your 
# Streamlit Community Cloud App Settings.
#
# Note: Streamlit automatically maps secrets to environment variables, allowing the 
# app to automatically pick up these connections.
#
# ==============================================================================

# ------------------------------------------------------------------------------
# Option A: Databricks SQL Warehouse Config
# ------------------------------------------------------------------------------
# Server hostname of your Databricks workspace (e.g. xxx.cloud.databricks.com)
DATABRICKS_SERVER_HOSTNAME = "your-databricks-workspace.cloud.databricks.com"

# The HTTP Path to the SQL warehouse (under Connection Details tab in SQL Warehouses)
DATABRICKS_HTTP_PATH = "/sql/1.0/warehouses/your-warehouse-id"

# Personal Access Token (PAT) generated in your user profile settings
DATABRICKS_ACCESS_TOKEN = "dapiYourAccessPersonalTokenHere"


# ------------------------------------------------------------------------------
# Option B: Snowflake Data Warehouse Config
# ------------------------------------------------------------------------------
# Snowflake user name (requires access to specified database/schema)
SNOWFLAKE_USER = "your_snowflake_username"

# Password for the user account
SNOWFLAKE_PASSWORD = "your_snowflake_password"

# Account identifier format: <orgname>-<locname> or <account_locator> (e.g. xy12345.us-east-2.aws)
SNOWFLAKE_ACCOUNT = "xy12345.us-east-2.aws"

# Warehouse used for computing queries
SNOWFLAKE_WAREHOUSE = "COMPUTE_WH"

# Target Database and Schema containing gold views
SNOWFLAKE_DATABASE = "STAR_AIR_DB"
SNOWFLAKE_SCHEMA = "GOLD"
