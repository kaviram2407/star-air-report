# ==========================================
# STAR AIR BI DASHBOARD - DATABASE SETTINGS
# ==========================================

# ------------------------------------------
# Option A: Databricks SQL Warehouse Config
# ------------------------------------------
# Get these from your Databricks Workspace -> SQL Warehouses -> Connection Details
DATABRICKS_SERVER_HOSTNAME=your-databricks-workspace.cloud.databricks.com
DATABRICKS_HTTP_PATH=/sql/1.0/warehouses/your-warehouse-id
DATABRICKS_ACCESS_TOKEN=dapiYourAccessPersonalTokenHere

# ------------------------------------------
# Option B: Snowflake Data Warehouse Config
# ------------------------------------------
# Configure credentials to pull Gold views from Snowflake tables
SNOWFLAKE_USER=your_snowflake_username
SNOWFLAKE_PASSWORD=your_snowflake_password
SNOWFLAKE_ACCOUNT=xy12345.us-east-2.aws
SNOWFLAKE_WAREHOUSE=COMPUTE_WH
SNOWFLAKE_DATABASE=STAR_AIR_DB
SNOWFLAKE_SCHEMA=GOLD
